{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 420
  },
  "bar": {
    "position": "left",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "pnr.windows"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "pnr.clock",
          "format": "dddd HH:mm",
          "verticalFormat": "yy\nMM\ndd\nHH\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.tray",
          "pinned": [
            "qps"
          ],
          "hidden": []
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "pnr.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "pnr.notifications"
  ]
}
